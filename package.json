{
  "name": "app-metal-calhas",
  "version": "1.4.5",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "start:mobile": "ng serve --host 0.0.0.0 --port 4200",
    "android:live": "cap run android --target emulator-5554 --live-reload --host 127.0.0.1 --port 4200 --forwardPorts 4200:4200",
    "android:logs": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/android-logs.ps1",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test"
  },
  "private": true,
  "packageManager": "npm@11.12.1",
  "dependencies": {
    "@angular/common": "^22.1.0",
